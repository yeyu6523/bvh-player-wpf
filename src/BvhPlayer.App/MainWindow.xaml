<Window x:Class="BvhPlayer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BvhPlayer.App"
        Title="BVH Player · 动作捕捉演示" Width="1320" Height="860" MinWidth="1080" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#F2F5F9" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" UseLayoutRounding="True"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" PreviewKeyDown="Window_KeyDown">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="132"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" BorderBrush="#DDE4EE" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#245CD7" Width="38" Height="38" CornerRadius="9" Margin="0,0,13,0">
            <Path Data="M10,8 L10,29 M10,8 L27,18.5 L10,29 M10,18.5 L20,18.5" Stroke="White" StrokeThickness="2" Width="22" Height="25" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel><TextBlock Text="BVH Player" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="骨骼层级与运动捕捉演示" FontSize="12" Foreground="{StaticResource Secondary}" Margin="0,2,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="内置行走示例" Click="Demo_Click" Margin="0,0,10,0" ToolTip="载入随程序附带的原创 BVH 行走示例"/>
          <Button Click="Open_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="OpenFile" AutomationProperties.Name="打开 BVH 文件" ToolTip="打开文件 (Ctrl+O)">
            <StackPanel Orientation="Horizontal"><Path Data="M1,4 L7,4 L9,7 L19,7 L19,18 L1,18 Z M1,8 L19,8" Stroke="White" StrokeThickness="1.5" Width="18" Height="17" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="打开 BVH 文件" Foreground="White"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="20,20,20,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>
      <Border Background="#111E30" CornerRadius="12" ClipToBounds="True">
        <Grid>
          <local:SkeletonView x:Name="Scene" Focusable="True" AutomationProperties.AutomationId="SkeletonViewport"/>
          <Grid VerticalAlignment="Top" Margin="20,18" IsHitTestVisible="True">
            <StackPanel IsHitTestVisible="False"><TextBlock x:Name="ViewportFile" Text="准备载入 BVH" FontSize="17" FontWeight="SemiBold" Foreground="#F1F6FF"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse x:Name="StateDot" Fill="#8B9AB0" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock x:Name="ViewportState" Text="已暂停" Foreground="#B5C3D8" FontSize="12"/></StackPanel></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
              <Button Content="正面" Style="{StaticResource ViewButton}" Click="Front_Click" Margin="0,0,6,0"/>
              <Button Content="侧面" Style="{StaticResource ViewButton}" Click="Side_Click" Margin="0,0,6,0"/>
              <Button Content="复位视角" Style="{StaticResource ViewButton}" Click="ResetView_Click" ToolTip="恢复三维视角 (R)"/>
            </StackPanel>
          </Grid>
          <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20,0,0,19" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Ellipse Width="6" Height="6" Fill="#54D8DA" Margin="0,0,6,0"/><TextBlock Text="左侧" Foreground="#C1CEDF" FontSize="11" Margin="0,0,16,0"/>
              <Ellipse Width="6" Height="6" Fill="#FFBE74" Margin="0,0,6,0"/><TextBlock Text="右侧" Foreground="#C1CEDF" FontSize="11" Margin="0,0,16,0"/>
              <Ellipse Width="6" Height="6" Fill="#DEE7F2" Margin="0,0,6,0"/><TextBlock Text="中轴" Foreground="#C1CEDF" FontSize="11"/>
            </StackPanel>
            <TextBlock Text="左键拖动旋转  ·  滚轮缩放  ·  右键拖动平移" Foreground="#A6B8D0" FontSize="11"/>
          </StackPanel>
          <Border x:Name="LoadingOverlay" Background="#D9111E30" Visibility="Collapsed"><TextBlock Text="正在解析 BVH 数据…" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="19,18">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
        <Grid MinHeight="510">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="动作信息" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="FileNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,9"/>
            <Grid Margin="0,0,0,2">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="23"/><RowDefinition Height="23"/></Grid.RowDefinitions>
              <TextBlock Text="帧数" Foreground="{StaticResource Secondary}"/><TextBlock x:Name="FrameCountText" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold"/>
              <TextBlock Text="采样率" Grid.Row="1" Foreground="{StaticResource Secondary}"/><TextBlock x:Name="FpsText" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"/>
              <TextBlock Text="关节 / 通道" Grid.Row="2" Foreground="{StaticResource Secondary}"/><TextBlock x:Name="JointsText" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"/>
            </Grid>
            <Border Height="1" Background="#E5EAF1" Margin="0,8,0,13"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,8"><TextBlock Text="播放速度" Style="{StaticResource SectionTitle}" Margin="0"/><TextBlock x:Name="SpeedText" Text="1.0×" Foreground="#245CD7" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="15"/></Grid>
            <Slider x:Name="SpeedSlider" Minimum="0.1" Maximum="3" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Speed_Changed" SmallChange="0.1" LargeChange="0.5" AutomationProperties.AutomationId="PlaybackSpeed" AutomationProperties.Name="播放速度"/>
            <Grid Margin="0,0,0,8"><TextBlock Text="0.1×" Foreground="{StaticResource Secondary}" FontSize="11"/><TextBlock Text="3.0×" Foreground="{StaticResource Secondary}" FontSize="11" HorizontalAlignment="Right"/></Grid>
            <UniformGrid Columns="4" Margin="0,0,0,12">
              <Button Content="0.5×" Tag="0.5" Click="SpeedPreset_Click" Padding="0,5" Margin="0,0,5,0" FontSize="12"/>
              <Button Content="1×" Tag="1" Click="SpeedPreset_Click" Padding="0,5" Margin="0,0,5,0" FontSize="12"/>
              <Button Content="1.5×" Tag="1.5" Click="SpeedPreset_Click" Padding="0,5" Margin="0,0,5,0" FontSize="12"/>
              <Button Content="2×" Tag="2" Click="SpeedPreset_Click" Padding="0,5" FontSize="12"/>
            </UniformGrid>
            <CheckBox x:Name="LoopCheck" Content="循环播放" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" AutomationProperties.AutomationId="LoopPlayback"/>
            <CheckBox x:Name="SmoothCheck" Content="平滑插值（四元数）" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed"/>
            <CheckBox x:Name="FollowCheck" Content="锁定根节点水平位移" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed" ToolTip="居中观察肢体动作；取消后显示原始空间移动"/>
            <CheckBox x:Name="GridCheck" Content="显示地面网格" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed"/>
            <Border Height="1" Background="#E5EAF1" Margin="0,2,0,12"/>
          </StackPanel>
          <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="骨骼层级" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
            <TreeView Grid.Row="1" x:Name="JointTree" MinHeight="72" BorderThickness="0" FontSize="12" Background="Transparent" SelectedItemChanged="Joint_Selected" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="骨骼层级树"/>
            <TextBlock Grid.Row="2" x:Name="JointInfo" Text="选择关节查看通道顺序" Foreground="{StaticResource Secondary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,8,0,0"/>
          </Grid>
        </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="White" CornerRadius="10" Margin="20,16,20,0" Padding="18,12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="播放时间轴" FontWeight="SemiBold"/><TextBlock x:Name="FrameLabel" Text="帧 1 / 1" HorizontalAlignment="Right" Foreground="{StaticResource Secondary}" FontSize="12"/></Grid>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Click="Stop_Click" AutomationProperties.Name="停止并回到首帧" ToolTip="停止并回到首帧 (Home)" Padding="11,8" Margin="0,0,7,0"><Path Data="M0,0 L12,0 L12,12 L0,12 Z" Fill="#526278" Width="12" Height="12"/></Button>
            <Button Click="Previous_Click" AutomationProperties.Name="上一帧" ToolTip="上一帧 (←)" Padding="11,8" Margin="0,0,7,0"><Path Data="M0,0 L0,12 M12,0 L4,6 L12,12 Z" Stroke="#526278" Fill="#526278" StrokeThickness="1.5" Width="12" Height="12"/></Button>
            <Button x:Name="PlayButton" Click="Play_Click" Style="{StaticResource PrimaryButton}" MinWidth="96" AutomationProperties.AutomationId="PlayPause" ToolTip="播放 / 暂停 (空格)">
              <StackPanel Orientation="Horizontal"><Path x:Name="PlayIcon" Data="M0,0 L0,14 L11,7 Z" Fill="White" Width="11" Height="14" Margin="0,0,9,0"/><TextBlock x:Name="PlayLabel" Text="播放" Foreground="White"/></StackPanel>
            </Button>
            <Button Click="Next_Click" AutomationProperties.Name="下一帧" ToolTip="下一帧 (→)" Padding="11,8" Margin="7,0,0,0"><Path Data="M12,0 L12,12 M0,0 L8,6 L0,12 Z" Stroke="#526278" Fill="#526278" StrokeThickness="1.5" Width="12" Height="12"/></Button>
          </StackPanel>
          <Slider x:Name="Timeline" Grid.Column="2" Minimum="0" Maximum="1" ValueChanged="Timeline_Changed" PreviewMouseLeftButtonDown="Timeline_Down" PreviewMouseLeftButtonUp="Timeline_Up" LostMouseCapture="Timeline_LostCapture" SmallChange="1" LargeChange="30" AutomationProperties.AutomationId="Timeline" AutomationProperties.Name="播放进度（帧）"/>
          <TextBlock x:Name="TimeLabel" Grid.Column="3" Text="00:00.00 / 00:00.00" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="13"/>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="3" Margin="24,0">
      <TextBlock x:Name="StatusText" Text="就绪 · 可将 BVH 文件拖入窗口" Foreground="{StaticResource Secondary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,370,0"/>
      <TextBlock Text="空格 播放/暂停    ← → 逐帧    R 复位    Ctrl+O 打开" Foreground="{StaticResource Secondary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
