      "html": "<label class=\"ds-checkbox\"><input type=\"checkbox\" checked/><span>循环播放</span></label>",
      "css": ".ds-checkbox{display:inline-flex;align-items:center;gap:5px;margin-bottom:7px;font:13px \"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;color:#526278;cursor:pointer}.ds-checkbox input{appearance:auto;margin:0;cursor:pointer}.ds-checkbox input:focus-visible{outline:1px dotted currentColor;outline-offset:2px}"
