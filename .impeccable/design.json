      "html": "<div class=\"ds-view-context\"><button class=\"ds-button ds-view-button\">复位视角</button></div>",
      "css": ".ds-button{font-family:\"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;font-size:13px;font-weight:400;min-height:36px;padding:9px 13px;border:1px solid #D7DEE9;border-radius:7px;cursor:pointer;color:#172438;background:#FFFFFF}.ds-button:hover{opacity:.8}.ds-button:active{opacity:.6}.ds-button:focus-visible{outline:none;border-color:#3F82F4;border-width:2px}.ds-button:disabled{opacity:.4;cursor:default}.ds-view-context{display:inline-flex;padding:18px 20px;background:#111E30;border-radius:12px}.ds-view-button{background:#203147;border-color:#40516A;color:#E5EDF7;font-size:12px;padding:6px 11px;min-height:32px}"
    },
    {
      "name": "Playback Slider",
      "kind": "input",
      "refersTo": "slider",
      "description": "Browser preview of the custom WPF Slider template. Native app geometry is 28 DIP high with a 4 DIP track and a 14 × 18 DIP thumb; browser track fill is illustrative.",
      "html": "<label class=\"ds-speed\"><span class=\"ds-speed-heading\">播放速度 <strong>1.0×</strong></span><input class=\"ds-slider\" aria-label=\"播放速度\" type=\"range\" min=\"0.1\" max=\"3\" step=\"0.1\" value=\"1\"/><span class=\"ds-speed-ends\"><span>0.1×</span><span>3.0×</span></span></label>",
      "css": ".ds-speed{display:block;width:240px;font-family:\"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;font-size:13px;color:#172438}.ds-speed-heading,.ds-speed-ends{display:flex;justify-content:space-between}.ds-speed-heading{font-weight:600}.ds-speed-heading strong{color:#245CD7;font-size:15px}.ds-speed-ends{font-size:11px;color:#526278}.ds-slider{appearance:none;display:block;width:calc(100% - 14px);height:28px;margin:0 7px;background:transparent;cursor:pointer}.ds-slider::-webkit-slider-runnable-track{height:4px;border-radius:2px;background:linear-gradient(to right,#245CD7 31%,#C7D2E2 31%)}.ds-slider::-webkit-slider-thumb{appearance:none;width:14px;height:18px;margin-top:-7px;border:2px solid #FFFFFF;border-radius:7px;background:#245CD7}.ds-slider::-moz-range-track{height:4px;border-radius:2px;background:#C7D2E2}.ds-slider::-moz-range-progress{height:4px;border-radius:2px;background:#245CD7}.ds-slider::-moz-range-thumb{width:10px;height:14px;border:2px solid #FFFFFF;border-radius:7px;background:#245CD7}.ds-slider:focus-visible{outline:none}.ds-slider:focus-visible::-webkit-slider-thumb{border-color:#152F61}.ds-slider:focus-visible::-moz-range-thumb{border-color:#152F61}"
    },
