  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "WPF PrimaryButton preview: open-file and play/pause commands. CSS is a documentation adaptation; the application uses a ControlTemplate.",
      "html": "<button class=\"ds-button ds-primary\"><svg width=\"18\" height=\"17\" viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M1 4H7L9 7H19V18H1ZM1 8H19\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg><span>打开 BVH 文件</span></button>",
      "css": ".ds-button{font-family:\"Microsoft YaHei UI\",\"Segoe UI\",sans-serif;font-size:13px;font-weight:400;min-height:36px;padding:9px 13px;border:1px solid #D7DEE9;border-radius:7px;cursor:pointer;color:#172438;background:#FFFFFF}.ds-button:hover{opacity:.8}.ds-button:active{opacity:.6}.ds-button:focus-visible{outline:none;border-color:#3F82F4;border-width:2px}.ds-button:disabled{opacity:.4;cursor:default}.ds-primary{display:inline-flex;gap:8px;align-items:center;justify-content:center;background:#245CD7;border-color:#245CD7;color:#FFFFFF}"
    },
